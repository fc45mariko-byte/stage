# Copy this file to .env and fill in what you want to activate. Restart the server after editing.

PORT=3000
# Public address of the app (used for the Gmail OAuth redirect). Use https:// in production.
BASE_URL=http://localhost:3000

# --- AI research & writing (web search, evaluation, handbook reading, document generation)
# Create a key at https://console.anthropic.com and make sure web search is enabled for your organization.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_FALLBACKS=off   # disables server-side refusal fallbacks

# --- Gmail sending (OAuth, permission "send" only)
# Google Cloud Console → enable Gmail API → OAuth consent screen (add yourself as test user)
# → OAuth client ID "Web application" with redirect URI  <BASE_URL>/api/integrations/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Alternative: SMTP (e.g. Gmail with an app password). Gmail OAuth is used first if connected.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=fc45.mariko@gmail.com
# SMTP_PASS=your-16-character-app-password

# Optional: where the database and documents are stored (default ./data)
# DATA_DIR=./data
